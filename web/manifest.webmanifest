    { "src": "/static/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/img/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Papelera", "short_name": "Papelera", "description": "Ver, restaurar o eliminar lo que borraste", "url": "/?abrir=papelera",
      "icons": [{ "src": "/static/img/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Archivos", "short_name": "Archivos", "description": "Subir y descargar archivos", "url": "/?abrir=archivos",
      "icons": [{ "src": "/static/img/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Historial", "short_name": "Historial", "description": "Tus pedidos anteriores", "url": "/?abrir=historial",
      "icons": [{ "src": "/static/img/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
